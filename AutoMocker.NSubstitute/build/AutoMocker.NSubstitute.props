<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 
    Make MSBuild properties visible to the Roslyn compiler for source generators.
    See: https://github.com/dotnet/roslyn/blob/main/docs/features/incremental-generators.cookbook.md#consume-msbuild-properties-and-metadata
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="EnableAutoMockerNSubstituteOptionsGenerator" />
    <CompilerVisibleProperty Include="EnableAutoMockerNSubstituteKeyedServicesGenerator" />
    <CompilerVisibleProperty Include="EnableAutoMockerNSubstituteFakeLoggingGenerator" />
    <CompilerVisibleProperty Include="EnableAutoMockerNSubstituteApplicationInsightsGenerator" />
    <CompilerVisibleProperty Include="EnableAutoMockerNSubstituteMeterFactoryGenerator" />
    <CompilerVisibleProperty Include="EnableAutoMockerNSubstituteFakeTimeProviderGenerator" />
  </ItemGroup>
</Project>
